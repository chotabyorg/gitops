# Voice public ingress guard, evaluated before Kubernetes service DNAT.
*mangle
:PREROUTING ACCEPT [0:0]
-A PREROUTING -i ens160 -p tcp -m conntrack --ctstate NEW -m multiport --dports 80,443,6443,10250,30000:32767 -m comment --comment chota-voice-public-k8s-guard -j DROP
-A PREROUTING -i ens160 -p udp -m conntrack --ctstate NEW -m multiport --dports 80,443,6443,8472,10250,30000:32767 -m comment --comment chota-voice-public-k8s-guard -j DROP
COMMIT
