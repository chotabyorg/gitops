# ArgoCD Repository Credential (SSH)
#
# This Secret gives ArgoCD access to the GitOps repository.
# It must be created in the argocd namespace BEFORE applying the
# Application/ApplicationSet manifests.
#
# Usage:
#   1. Copy this template:   cp secrets.yaml.template secrets.yaml
#   2. Fill in your SSH private key
#   3. Seal it:              kubeseal --format yaml < secrets.yaml > sealed-secrets.yaml
#   4. Install SealedSecrets controller on the cluster
#   5. Apply:                kubectl apply -f sealed-secrets.yaml
#   6. Delete the unsealed file:  rm secrets.yaml
#
# Alternatively, apply directly without sealing:
#   kubectl create secret generic -n argocd gitops-repo \
#     --from-literal=type=git \
#     --from-literal=url=git@github.com:chotabyorg/gitops.git \
#     --from-file=sshPrivateKey=/path/to/id_ed25519
#   kubectl label secret -n argocd gitops-repo argocd.argoproj.io/secret-type=repository
---
apiVersion: v1
kind: Secret
metadata:
  name: gitops-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: git@github.com:chotabyorg/gitops.git
  sshPrivateKey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    REPLACE_WITH_YOUR_SSH_PRIVATE_KEY
    -----END OPENSSH PRIVATE KEY-----
