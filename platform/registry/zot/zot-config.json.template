{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "tls": {
      "cert": "/etc/zot/tls/tls.crt",
      "key": "/etc/zot/tls/tls.key"
    },
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/auth/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "REPLACE_WITH_EXACT_AISTOR_REPOSITORY_PATTERN": {
          "anonymousPolicy": [],
          "defaultPolicy": [],
          "policies": [
            {
              "users": ["REPLACE_WITH_PUBLISHER_ID"],
              "actions": ["read", "create"]
            },
            {
              "users": ["REPLACE_WITH_PULLER_ID"],
              "actions": ["read"]
            }
          ]
        }
      },
      "adminPolicy": {
        "users": ["REPLACE_WITH_BREAK_GLASS_ADMIN_ID"],
        "actions": ["read", "create", "update", "delete"]
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "metrics": {
      "enable": true
    }
  }
}
