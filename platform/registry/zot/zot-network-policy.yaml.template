apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: zot-registry-default-deny
  namespace: registry
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: zot
      app.kubernetes.io/component: registry
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: 5000
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
