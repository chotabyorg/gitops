apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: zot-registry
  namespace: REPLACE_WITH_REGISTRY_NAMESPACE
  labels:
    app.kubernetes.io/name: zot
    app.kubernetes.io/component: registry
spec:
  serviceName: zot-registry
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: zot
      app.kubernetes.io/component: registry
  template:
    metadata:
      labels:
        app.kubernetes.io/name: zot
        app.kubernetes.io/component: registry
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: zot
          image: REPLACE_WITH_APPROVED_ZOT_PLATFORM_IMAGE_DIGEST
          imagePullPolicy: IfNotPresent
          args:
            - serve
            - /etc/zot/config/config.json
          ports:
            - name: https
              containerPort: 5000
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: REPLACE_WITH_APPROVED_CPU_REQUEST
              memory: REPLACE_WITH_APPROVED_MEMORY_REQUEST
            limits:
              cpu: REPLACE_WITH_APPROVED_CPU_LIMIT
              memory: REPLACE_WITH_APPROVED_MEMORY_LIMIT
          readinessProbe:
            httpGet:
              scheme: HTTPS
              path: /v2/
              port: https
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          livenessProbe:
            httpGet:
              scheme: HTTPS
              path: /v2/
              port: https
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - name: data
              mountPath: /var/lib/zot
            - name: config
              mountPath: /etc/zot/config
              readOnly: true
            - name: auth
              mountPath: /etc/zot/auth
              readOnly: true
            - name: tls
              mountPath: /etc/zot/tls
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: zot-registry-data
        - name: config
          configMap:
            name: zot-registry-config
        - name: auth
          secret:
            secretName: REPLACE_WITH_ZOT_HTPASSWD_SECRET
        - name: tls
          secret:
            secretName: REPLACE_WITH_ZOT_TLS_SECRET
        - name: tmp
          emptyDir: {}
