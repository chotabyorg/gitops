# No prod directory exists until the exact reviewed stage1 is materialized.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: prod
resources:
  - ../base
  - readonly-sealed-secret.yaml
  - managed-sealed-secret.yaml
  - relay-network-policy.yaml
images:
  - name: goal4a-accepted-ai
    newName: ghcr.io/chotabyorg/ai-agent-service
    digest: sha256:5eba680cf018acf0f8062bbc1b0909e8c09ff157795e5a7f79ac4232a863ef4c
  - name: goal4a-nginx
    newName: docker.io/library/nginx
    digest: sha256:8f029c543423e3eac6b08254718bc31eb75633b1e448026b6616927baa7d4bfe
configMapGenerator:
  - name: goal4a-ai-config
    envs: [config.properties]
  - name: goal4a-ai-guard
    files: [nginx.conf=guard.conf]
  - name: goal4a-llm-relay
    files: [nginx.conf=relay.conf]
  - name: goal4a-role-operations
    files: [role.py, release-inputs.json]
generatorOptions:
  annotations: {argocd.argoproj.io/sync-wave: '-7'}
