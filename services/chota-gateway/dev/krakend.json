{
  "$schema": "https://www.krakend.io/schema/v2.13/krakend.json",
  "version": 3,
  "name": "chota-gateway",
  "timeout": "60s",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "https://chota.by"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PATCH",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Content-Type",
        "Cookie"
      ],
      "expose_headers": [
        "Set-Cookie"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "method": "POST",
          "host": [
            "http://user-service"
          ]
        }
      ]
    },
