# Add only this new env key; retain current image, TLS/signing, hooks and secrets.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ai-agent-service
spec:
  template:
    spec:
      containers:
        - name: ai-agent-service
          env:
            - name: MANAGED_AI_AUTH_PRINCIPALS
              valueFrom:
                secretKeyRef:
                  name: ai-conversation-managed-secret
                  key: MANAGED_AI_AUTH_PRINCIPALS
