# Actual current Docker CMD plus access suppression; migration/init unchanged.
# Release with the independently reviewed CP source logging fix image, not merely
# this CLI override: DTO construction errors require application protection too.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: control-plane-service
spec:
  template:
    spec:
      containers:
        - name: control-plane-service
          command: [uvicorn, main:app, --host, 0.0.0.0, --port, '8000', --no-access-log]
