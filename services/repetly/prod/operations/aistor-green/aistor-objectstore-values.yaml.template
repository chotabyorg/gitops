# DRAFT ONLY. This file is not referenced by the active production
# Kustomization or Argo Application. Render/apply only after the separate
# production rollout approvals in README.md are complete.

secrets:
  name: repetly-aistor-green-env
  existingSecret: true

objectStore:
  name: repetly-aistor-green

  image:
    # PREFERRED path: the official digest form below is retained in the
    # release ledger, but Operator 5.11.1/5.11.2/5.11.3 reject it while
    # reconciling the CR with "invalid image format". This is a vendor
    # limitation. The selected conditional production path is the immutable
    # Zot content tag below; a mutable public RELEASE tag is rejected.
    repository: registry.chota.by/aistor/minio
    tag: aistor-minio-e8394b040720
    pullPolicy: IfNotPresent

  # Dedicated private-registry pull-only Secret in namespace prod. It must
  # contain only a pull-scoped .dockerconfigjson for registry.chota.by.
  imagePullSecret:
    name: aistor-zot-puller

  pools:
    - name: pool-0
      servers: 1
      volumesPerServer: 1
      size: 10Gi
      storageClassName: local-path
      nodeSelector:
        kubernetes.io/arch: amd64
      resources:
        requests:
          cpu: 500m
          memory: 768Mi
        limits:
          cpu: "1"
          memory: 1Gi
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
      containerSecurityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
        seccompProfile:
          type: RuntimeDefault

  mountPath: /export
  subPath: /data
  pvcProtection: true

  services:
    console:
      serviceType: ClusterIP
    minio:
      serviceType: ClusterIP

  # The Operator issues internal service certificates. External registry TLS
  # is terminated by Traefik; AIStor remains private ClusterIP during P0.
  certificates:
    disableAutoCert: false

  startup:
    httpGet:
      path: /minio/health/live
      port: 9000
      scheme: HTTPS
    failureThreshold: 30
    periodSeconds: 5
    timeoutSeconds: 3
  readiness:
    httpGet:
      path: /minio/health/ready
      port: 9000
      scheme: HTTPS
    failureThreshold: 6
    periodSeconds: 10
    timeoutSeconds: 3
  liveness:
    httpGet:
      path: /minio/health/live
      port: 9000
      scheme: HTTPS
    failureThreshold: 3
    periodSeconds: 10
    timeoutSeconds: 3

  sideCars:
    resources:
      requests:
        cpu: 50m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 128Mi

  env:
    - name: MINIO_API_AUTO_BUMP
      value: "off"
