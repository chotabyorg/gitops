# DRAFT ONLY. This file is not referenced by the active production
# Kustomization or Argo Application. Install the chart in namespace prod only
# after the separate production rollout approvals in README.md are complete.

# Keep the license outside Git. The Operator mounts the separately managed
# `minio-license` Secret; no license bytes belong in Helm values.
license: ""

global:
  fipsMode: false
  operator:
    replicas: 1
    imagePullPolicy: IfNotPresent
    # Namespace-scoped watch keeps this P0 from reconciling unrelated CRs.
    watchedNamespaces:
      - prod
    # Do not grant the Operator's CSR signer/approval ClusterRole to the
    # prod-scoped service accounts. Operator and webhook TLS are supplied by
    # the out-of-band Secret contracts documented beside this file.
    optOutAutomaticCertificates: true
    # The upgrade webhook is distinct from the admission webhook below.
    # Secret values and CA material remain out of Git.
    extraEnv:
      - name: OPERATOR_AUTO_CERT_DISABLED
        value: "on"
      - name: OPERATOR_CUSTOM_TLS_SECRET_NAME
        value: object-store-operator-tls
    imagePullSecrets:
      - name: aistor-zot-puller
    resources:
      requests:
        cpu: 200m
        memory: 256Mi
        ephemeral-storage: 500Mi
      limits:
        cpu: 500m
        memory: 256Mi
        ephemeral-storage: 500Mi

operators:
  adminjob:
    # AdminJob is disabled; no unpinned mc client may materialize.
    disabled: true
  aihub:
    disabled: true
  object-store:
    disabled: false
    # Production k3s OIDC discovery/JWKS reachability and CA trust have not
    # been re-verified in this read-only session. Keep the vendor-supported
    # TokenReview path and document its exact bounded cluster-wide exception.
    tokenValidation: TokenReview
    webhook:
      enabled: true
      replicas: 1
      # Admission webhook TLS is separate from the Operator upgrade webhook.
      # The CA bundle is injected at the final out-of-band render; this
      # fail-closed placeholder must never be applied as-is.
      caBundle: "__BASE64_CA_BUNDLE_SET_AT_ACTIVATION__"
      extraEnv:
        - name: WEBHOOK_CUSTOM_TLS_SECRET_NAME
          value: object-store-webhook-tls
  prompt:
    disabled: true
  warp:
    disabled: true

repositories:
  aistor:
    hostname: quay.io
    pathPrefix: minio/aistor/

# Exact linux/amd64 child digests resolved from the official chart defaults.
# The selected ObjectStore main runtime uses the owner-approved immutable Zot
# tag because the native digest parser is vendor-limited. Operator and
# sidecar/config images remain exact public Quay digest candidates until the
# mirror ledger explicitly includes them.
images:
  operator:
    repository: aistor
    image: operator@sha256:b88e5cf563406719f67028a52fef9dac4049e555f44e263267c30a069d1d8166
  minwall:
    repository: aistor
    image: minwall@sha256:0f831ea63e6269540f96b312020e1759ab2cd9218ef9c08c108756a54a4ccb99
  kes:
    repository: aistor
    image: kes@sha256:7872b91e8cdd580f6eb7ef9d3608e54d228f10199acb83e3e69994ad80ace93e
  kes-sidecar:
    repository: aistor
    image: kes-sidecar@sha256:fe0b7980565240ca415b8edb403b0361a17ff5f93e6e3b6774c0d1505096b57b
  minio:
    repository: aistor
    image: minio@sha256:e8394b0407206d967208d86040a0c82e87c2b912068e2fdd2e876777bf2d16a1
  minio-sidecar:
