# DRAFT ONLY. This file is not referenced by any active Kustomization or Argo
# Application. It is intentionally incomplete until production preflight and
# rendered image-digest review are complete.

# Keep the license outside Git. The operator expects the separately managed
# minio-license Secret; never put the AIStor license in Helm values.
license: ""

global:
  fipsMode: false
  operator:
    replicas: 1
    imagePullPolicy: IfNotPresent
  # Narrow the watch scope after the target namespace and RBAC are approved.
  # operator:
  #   watchedNamespaces:
  #     - prod

operators:
  adminjob:
    disabled: false
  aihub:
    disabled: true
  object-store:
    disabled: false
  prompt:
    disabled: true
  warp:
    disabled: true

repositories:
  aistor:
    hostname: quay.io
    pathPrefix: minio/aistor/

# The chart's rendered image set must be resolved to immutable digests before
# activation. Do not rely on chart defaults without recording that evidence.
