# DRAFT ONLY. This file is not referenced by any active Kustomization or Argo
# Application. It is intentionally incomplete until production preflight and
# rendered image-digest review are complete.

# Keep the license outside Git. The operator mounts a separately managed
# `minio-license` Secret from the operator release namespace; never put the
# AIStor license in Helm values.
license: ""

global:
  fipsMode: false
  operator:
    replicas: 1
    imagePullPolicy: IfNotPresent
    # Narrow the watch scope after the target namespace and RBAC are approved.
    # This is the actual chart key; an empty value keeps cluster-wide watch mode.
    # watchedNamespaces:
    #   - prod

operators:
  adminjob:
    # The chart's AdminJob controller injects the currently ineligible mc image
    # into its ConfigMap. Keep this controller disabled until a separately
    # pinned, scanned, and approved admin client exists.
    disabled: true
  aihub:
    disabled: true
  object-store:
    disabled: false
  prompt:
    disabled: true
  warp:
    disabled: true

repositories:
  aistor:
    hostname: quay.io
    pathPrefix: minio/aistor/

# These are the exact linux/amd64 child digests resolved from the manifest
# lists in the exact chart defaults on 2026-08-10. They are immutable pins,
# not security approvals. Disabled/config-only images are retained because the
# chart may serialize them into ConfigMaps, but must not become runtime objects
# without a fresh scan and review.
# direct Trivy results and disposition are recorded in README.md. The AdminJob
# controller is disabled, so the separate mc client is intentionally not part
# of this Operator image map.
images:
  operator:
    repository: aistor
    image: operator@sha256:b88e5cf563406719f67028a52fef9dac4049e555f44e263267c30a069d1d8166
  minwall:
    repository: aistor
    image: minwall@sha256:0f831ea63e6269540f96b312020e1759ab2cd9218ef9c08c108756a54a4ccb99
  kes:
    repository: aistor
    image: kes@sha256:7872b91e8cdd580f6eb7ef9d3608e54d228f10199acb83e3e69994ad80ace93e
  kes-sidecar:
    repository: aistor
    image: kes-sidecar@sha256:fe0b7980565240ca415b8edb403b0361a17ff5f93e6e3b6774c0d1505096b57b
  minio:
    repository: aistor
    image: minio@sha256:e8394b0407206d967208d86040a0c82e87c2b912068e2fdd2e876777bf2d16a1
  minio-sidecar:
    repository: aistor
    image: minio-sidecar@sha256:560e204d8fbd05d095719a39af0db36e177829528d80366962d1bc22102c9b57

