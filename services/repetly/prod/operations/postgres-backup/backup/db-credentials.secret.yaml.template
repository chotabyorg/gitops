# Template only. Seal or otherwise provision outside Git; never commit values.
# The backup role is separate from the application role and must use TLS.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: repetly-postgres-backup-db-credentials
  namespace: prod
stringData:
  PGHOST: REPLACE_WITH_POSTGRES_HOST
  PGPORT: "5432"
  PGUSER: repetly_backup
  PGPASSWORD: REPLACE_WITH_ROTATABLE_BACKUP_ROLE_PASSWORD
  PGSSLMODE: verify-full
  PGSSLROOTCERT: /var/run/repetly-backup-db-ca/ca.crt
