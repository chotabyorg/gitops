# Template only. Provision through the approved Secret workflow, never Git.
# This identity is intentionally distinct from both the DB backup login and the
# restore reader identity. It must have no Delete action.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: repetly-postgres-backup-writer-credentials
  namespace: prod
stringData:
  AWS_ACCESS_KEY_ID: REPLACE_WITH_BACKUP_WRITER_ACCESS_KEY
  AWS_SECRET_ACCESS_KEY: REPLACE_WITH_BACKUP_WRITER_SECRET
